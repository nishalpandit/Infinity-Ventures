  <!-- REQUIREMENT-BASED BIDDING SUITE (PDF REQUIREMENT PAGES 3 & 4) -->
  <section class="bidding-suite-section" id="biddingShowcaseSection">
    <div class="container">
      <div class="bidding-box-terminal">
        <div class="bidding-header-meta">
          <span class="badge-bidding-tag"><i class="fa-solid fa-gavel"></i> Multi-Contractor Quotation Marketplace</span>
          <h2 class="brand-font">Have a Custom Project or Large Job? Post &amp; Get Bids</h2>
          <p>
            For requirements like 3 BHK painting, interior renovation, or commercial setup: post your details once, receive competitive quotations from top verified local contractors, compare work details, and choose the best offer.
          </p>
        </div>

        <div class="bidding-columns-split">
          <!-- 4-Step Interactive Form -->
          <div class="bidding-interactive-form">
            <h3><i class="fa-solid fa-file-pen" style="color: #818cf8;"></i> Post Custom Requirement in 60s</h3>
            
            <form id="biddingPostForm" onsubmit="handlePostCustomRequirement(event)">
              {% csrf_token %}
              <div class="bidding-input-group">
                <label>Select Service Category</label>
                <select id="bidCategory" class="input-dark-custom" required>
                  <option value="">Choose category...</option>
                  {% for cat in categories %}
                  <option value="{{ cat.id }}">{{ cat.name }}</option>
                  {% empty %}
                  <option value="1">Painting &amp; Waterproofing</option>
                  <option value="2">Full Home Interior Renovation</option>
                  <option value="3">Modular Kitchen &amp; Woodwork</option>
                  <option value="4">Commercial Electrical Setup</option>
                  {% endfor %}
                </select>
              </div>

              <div class="bidding-input-group">
                <label>Requirement Title &amp; Scope</label>
                <input type="text" id="bidTitle" class="input-dark-custom" placeholder="e.g. Complete 3 BHK Wall Painting with Asian Paints" required>
              </div>

              <div class="two-column-inputs">
                <div class="bidding-input-group">
                  <label>Estimated Budget (₹)</label>
                  <input type="number" id="bidBudget" class="input-dark-custom" placeholder="e.g. 15000" min="500" required>
                </div>
                <div class="bidding-input-group">
                  <label>Preferred Timeline</label>
                  <select id="bidTimeline" class="input-dark-custom">
                    <option value="immediate">Immediate (1-2 days)</option>
                    <option value="week">Within this week</option>
                    <option value="flexible">Flexible / Planning</option>
                  </select>
                </div>
              </div>

              <div class="bidding-input-group">
                <label>Description &amp; Specific Details</label>
                <textarea id="bidDesc" class="input-dark-custom" rows="2" placeholder="Mention room count, square footage, materials preference, etc."></textarea>
              </div>

              <div class="bidding-input-group">
                <label>Contact Mobile Number</label>
                <input type="tel" id="bidMobile" class="input-dark-custom" placeholder="Enter 10-digit phone number" value="{% if user.is_authenticated %}{{ user.user_profile.phone_number|default:'' }}{% endif %}" required>
              </div>

              <button type="submit" id="btnSubmitBid" class="btn-broadcast-job">
                <span>Broadcast to Local Contractors</span>
                <i class="fa-solid fa-paper-plane"></i>
              </button>
            </form>
          </div>

          <!-- Live Bids Comparator Preview -->
          <div class="bids-comparator-suite">
            <div class="comparator-top-bar">
              <h4>Live Quotations: 3 BHK Painting</h4>
              <span class="live-quotes-counter"><i class="fa-solid fa-circle" style="font-size: 8px;"></i> 3 Quotes Received</span>
            </div>

            <div class="bids-feed-cards">
              <!-- Bid 1 -->
              <div class="contractor-bid-tile">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <div class="c-avatar-wrap">QP</div>
                  <div class="c-details-wrap">
                    <h5>
                      <span>QuickFix Paint Masters</span>
                      <i class="fa-solid fa-circle-check" style="color: #38bdf8; font-size: 11px;"></i>
                    </h5>
                    <p>★ 4.9 (124 jobs) · Asian Paints Royale Included</p>
                  </div>
                </div>
                <div class="quote-pricing-block">
                  <div class="quote-amount">₹14,500</div>
                  <div class="quote-duration">2 Days Timeline</div>
                  <button type="button" class="btn-accept-contractor" onclick="handleAcceptBidDemo('QuickFix Paint Masters', 14500)">Accept Quote</button>
                </div>
              </div>

              <!-- Bid 2 -->
              <div class="contractor-bid-tile">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <div class="c-avatar-wrap">AP</div>
                  <div class="c-details-wrap">
                    <h5>
                      <span>Apex Pro Decorators</span>
                      <i class="fa-solid fa-circle-check" style="color: #38bdf8; font-size: 11px;"></i>
                    </h5>
                    <p>★ 4.8 (89 jobs) · Labour &amp; Putty Only</p>
                  </div>
                </div>
                <div class="quote-pricing-block">
                  <div class="quote-amount">₹13,200</div>
                  <div class="quote-duration">3 Days Timeline</div>
                  <button type="button" class="btn-accept-contractor" onclick="handleAcceptBidDemo('Apex Pro Decorators', 13200)">Accept Quote</button>
                </div>
              </div>

              <!-- Bid 3 -->
              <div class="contractor-bid-tile">
                <div style="display: flex; align-items: center; gap: 12px;">
                  <div class="c-avatar-wrap">UC</div>
                  <div class="c-details-wrap">
                    <h5>
                      <span>Urban Craftsmen</span>
                      <i class="fa-solid fa-circle-check" style="color: #38bdf8; font-size: 11px;"></i>
                    </h5>
                    <p>★ 4.95 (210 jobs) · Dulux Velvet + 1 Yr Warranty</p>
                  </div>
                </div>
                <div class="quote-pricing-block">
                  <div class="quote-amount">₹15,200</div>
                  <div class="quote-duration">2 Days Timeline</div>
                  <button type="button" class="btn-accept-contractor" onclick="handleAcceptBidDemo('Urban Craftsmen', 15200)">Accept Quote</button>
                </div>
              </div>
            </div>

            <div style="margin-top: 18px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.1); font-size: 12.5px; color: #94a3b8; display: flex; align-items: center; justify-content: space-between;">
              <span><i class="fa-solid fa-shield-halved" style="color: #34d399;"></i> 100% Price Protection Guarantee</span>
              <a href="{% url 'user_dashboard' %}" style="color: #818cf8; font-weight: 700;">View in Dashboard &rarr;</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST & SAFETY STANDARDS -->
  <section class="trust-guarantee-section">
    <div class="container">
      <div style="text-align: center; margin-bottom: 40px;">
        <h2 style="font-size: 32px; font-weight: 900; color: var(--text-dark); margin-bottom: 6px;">The Infinity Standard of Excellence</h2>
        <p style="color: var(--text-muted); font-size: 15.5px;">Built on rigorous safety, transparent pricing, and customer-first guarantees</p>
      </div>

      <div class="trust-cards-grid">
        <!-- Pillar 1 -->
        <div class="trust-feature-card">
          <div class="trust-icon-holder"><i class="fa-solid fa-user-shield"></i></div>
          <h3>Verified Professionals</h3>
          <p>Every technician undergoes comprehensive identity, police background checks, and practical skills certification.</p>
        </div>

        <!-- Pillar 2 -->
        <div class="trust-feature-card">
          <div class="trust-icon-holder"><i class="fa-solid fa-tags"></i></div>
          <h3>Transparent Pricing</h3>
          <p>Standardized rate cards across all services with zero hidden surprises or surge markups at checkout.</p>
        </div>

        <!-- Pillar 3 -->
        <div class="trust-feature-card">
          <div class="trust-icon-holder"><i class="fa-solid fa-medal"></i></div>
          <h3>30-Day Service Warranty</h3>
