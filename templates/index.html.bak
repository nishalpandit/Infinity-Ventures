  <!-- SLIDE-OVER CART & INSTANT BOOKING DRAWER -->
  <div id="cartDrawerOverlay" class="cart-drawer-backdrop" onclick="toggleCartDrawer()"></div>
  
  <aside id="cartDrawer" class="cart-drawer-aside">
    <div class="drawer-header-bar">
      <h3>
        <i class="fa-solid fa-bag-shopping" style="color: var(--indigo-core);"></i>
        <span>My Instant Cart</span>
        <span id="drawerCountPill" class="cart-badge-counter" style="margin-left: 6px;">0</span>
      </h3>
      <button type="button" class="btn-close-circle" onclick="toggleCartDrawer()">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Step 1: Cart Items & Bill -->
    <div id="drawerStepCart" class="drawer-body-scrollable">
      <div id="cartEmptyMessage" class="cart-empty-panel">
        <i class="fa-solid fa-bag-shopping"></i>
        <h4 style="font-size: 16px; font-weight: 700; color: var(--text-dark); margin-bottom: 6px;">Your cart is empty</h4>
        <p style="font-size: 13.5px;">Add any service package to start your instant direct booking!</p>
      </div>

      <div id="cartActiveContent" style="display: none;">
        <!-- Items List -->
        <div id="cartItemsList" style="margin-bottom: 24px;">
          <!-- Dynamically injected -->
        </div>

        <!-- Coupon Card -->
        <div class="coupon-box-panel">
          <input type="text" id="couponInput" placeholder="Enter coupon code" value="UCFIRST">
          <button type="button" class="btn-coupon-apply" onclick="applyCouponCode()">Apply</button>
        </div>
        <div id="couponMessage" style="font-size: 12.5px; color: #16a34a; font-weight: 700; margin-top: -12px; margin-bottom: 14px; display: none;"></div>

        <!-- Bill Details -->
        <div class="bill-summary-panel">
          <div class="bill-detail-line">
            <span>Item Total</span>
            <span id="billItemTotal">₹0</span>
          </div>
          <div class="bill-detail-line" id="billDiscountRow" style="display: none; color: #16a34a;">
            <span>Coupon Discount</span>
            <span id="billDiscount">-₹100</span>
          </div>
          <div class="bill-detail-line">
            <span>Safety &amp; Hygiene Fee</span>
            <span>₹49</span>
          </div>
          <div class="bill-detail-line">
            <span>Taxes &amp; Platform Charges</span>
            <span id="billTaxes">₹28</span>
          </div>
          <div class="bill-detail-line grand-total">
            <span>Total Payable</span>
            <span id="billGrandTotal">₹0</span>
          </div>
        </div>

        <!-- Date & Slot Picker -->
        <div style="margin-bottom: 18px;">
          <h4 style="font-size: 14px; font-weight: 800; color: var(--text-dark); margin-bottom: 10px;">Select Preferred Service Slot</h4>
          <div style="display: flex; gap: 10px; margin-bottom: 12px;">
            <button type="button" class="city-btn-tile active" style="flex: 1;" onclick="selectSlotDay(this, 'Today')">Today<br><span style="font-size: 11px; font-weight: 500;">17 Sep</span></button>
            <button type="button" class="city-btn-tile" style="flex: 1;" onclick="selectSlotDay(this, 'Tomorrow')">Tomorrow<br><span style="font-size: 11px; font-weight: 500;">18 Sep</span></button>
            <button type="button" class="city-btn-tile" style="flex: 1;" onclick="selectSlotDay(this, 'Friday')">Friday<br><span style="font-size: 11px; font-weight: 500;">19 Sep</span></button>
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
            <button type="button" class="city-btn-tile active" onclick="selectSlotTime(this, '09:00 AM - 12:00 PM')">09:00 AM - 12:00 PM</button>
            <button type="button" class="city-btn-tile" onclick="selectSlotTime(this, '01:00 PM - 04:00 PM')">01:00 PM - 04:00 PM</button>
            <button type="button" class="city-btn-tile" onclick="selectSlotTime(this, '05:00 PM - 08:00 PM')">05:00 PM - 08:00 PM</button>
            <button type="button" class="city-btn-tile" onclick="selectSlotTime(this, '08:00 PM - 10:00 PM')">08:00 PM - 10:00 PM</button>
          </div>
        </div>

        <!-- Service Address -->
        <div style="margin-bottom: 16px;">
          <h4 style="font-size: 14px; font-weight: 800; color: var(--text-dark); margin-bottom: 6px;">Service Address</h4>
          <input type="text" id="checkoutAddress" class="input-dark-custom" style="color: #090d16; background: #f8fafc; border: 1px solid var(--border-subtle);" placeholder="Flat / House No., Landmark, Area" value="Flat 402, Green Valley Apartments, Morabadi, Ranchi">
        </div>
      </div>
    </div>

    <!-- Step 2: Live Tracking -->
    <div id="drawerStepTracking" class="drawer-body-scrollable" style="display: none;">
      <div style="text-align: center; padding: 24px 0;">
        <div style="width: 68px; height: 68px; border-radius: 50%; background: #dcfce7; color: #16a34a; display: flex; align-items: center; justify-content: center; font-size: 30px; margin: 0 auto 16px;">
          <i class="fa-solid fa-check"></i>
        </div>
        <h3 style="font-size: 22px; font-weight: 900; color: var(--text-dark); margin-bottom: 4px;">Booking Confirmed!</h3>
        <p style="font-size: 13.5px; color: var(--text-muted); margin-bottom: 24px;">Booking Reference: <strong id="confirmedRefId">#IV-84920</strong></p>
        
        <!-- Live Status Tracker Progression -->
        <div style="display: flex; flex-direction: column; gap: 16px; text-align: left; margin-bottom: 28px;">
          <div style="display: flex; align-items: center; gap: 14px;">
            <div style="width: 26px; height: 26px; border-radius: 50%; background: #16a34a; color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800;"><i class="fa-solid fa-check"></i></div>
            <div>
              <h5 style="font-size: 14px; font-weight: 800; color: var(--text-dark);">Booking Placed &amp; Assigned</h5>
              <p style="font-size: 12px; color: var(--text-muted);">Technician Rajesh Kumar assigned (★ 4.88 · 850+ jobs)</p>
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 14px;">
            <div style="width: 26px; height: 26px; border-radius: 50%; background: var(--indigo-core); color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.2);"><i class="fa-solid fa-car-side"></i></div>
            <div>
              <h5 style="font-size: 14px; font-weight: 800; color: var(--text-dark);">Professional On The Way</h5>
              <p style="font-size: 12px; color: var(--text-muted);">Estimated arrival in 35 minutes · Live GPS active</p>
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 14px;">
            <div style="width: 26px; height: 26px; border-radius: 50%; background: #e2e8f0; color: #64748b; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800;">3</div>
            <div>
              <h5 style="font-size: 14px; font-weight: 800; color: var(--text-dark);">Service In Progress</h5>
              <p style="font-size: 12px; color: var(--text-muted);">Standard safety checklist &amp; genuine part verification</p>
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 14px;">
            <div style="width: 26px; height: 26px; border-radius: 50%; background: #e2e8f0; color: #64748b; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800;">4</div>
            <div>
              <h5 style="font-size: 14px; font-weight: 800; color: var(--text-dark);">Completion &amp; Warranty</h5>
              <p style="font-size: 12px; color: var(--text-muted);">Digital invoice &amp; 30-day service warranty issued</p>
            </div>
          </div>
        </div>

        <button type="button" class="btn-broadcast-job" style="background: var(--primary);" onclick="resetCartAndClose()">
          <span>Continue Exploring</span>
        </button>
      </div>
    </div>

    <!-- Footer Checkout Button -->
    <div id="cartDrawerFooter" class="drawer-footer-actions" style="display: none;">
      <button type="button" class="btn-instant-confirm" onclick="executeInstantBooking()">
        <span id="footerBtnAmount">Pay ₹0</span>
        <span>Confirm &amp; Book Pro &rarr;</span>
      </button>
    </div>
  </aside>

  <!-- SERVICE DETAIL MODAL -->
  <div id="serviceDetailModal" class="overlay-modal" onclick="closeServiceDetailModal(event)">
    <div class="modal-frame">
      <div class="modal-top-bar">
        <h3 id="modalServiceTitle">Service Details</h3>
        <button type="button" class="btn-close-circle" onclick="closeServiceDetailModalDirect()"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-content-area">
        <img id="modalServiceImg" src="" style="width: 100%; height: 200px; object-fit: cover; border-radius: 14px; margin-bottom: 18px;" alt="">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
          <div>
            <span id="modalServiceRating" class="star-score-badge"><i class="fa-solid fa-star"></i> 4.85</span>
            <span id="modalServiceDuration" style="font-size: 13px; color: var(--text-muted); margin-left: 8px;">45 mins</span>
          </div>
          <span id="modalServicePrice" style="font-size: 22px; font-weight: 900; color: var(--text-dark);">₹499</span>
        </div>

        <h4 style="font-size: 15px; font-weight: 800; margin-bottom: 8px;">What's Included:</h4>
        <ul id="modalServiceInclusions" class="package-checklist" style="margin-bottom: 20px;">
          <!-- Populated by JS -->
        </ul>

        <h4 style="font-size: 15px; font-weight: 800; margin-bottom: 8px;">What's Not Included:</h4>
        <ul id="modalServiceExclusions" class="package-checklist" style="margin-bottom: 22px;">
          <!-- Populated by JS -->
        </ul>

        <button type="button" id="modalServiceAddBtn" class="btn-broadcast-job" onclick="addFromModal()">
          <span>Add to Instant Cart</span>
        </button>
      </div>
    </div>
  </div>

  <!-- LOCATION SELECTOR MODAL -->
  <div id="locationModal" class="overlay-modal" onclick="closeLocationModal(event)">
    <div class="modal-frame">
      <div class="modal-top-bar">
        <h3>Select Your City</h3>
        <button type="button" class="btn-close-circle" onclick="closeLocationModalDirect()"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-content-area">
        <div class="search-input-shell" style="margin-bottom: 16px;">
          <i class="fa-solid fa-location-crosshairs" style="color: var(--indigo-glow);"></i>
          <input type="text" id="citySearchInput" placeholder="Search for your city..." oninput="filterCityButtons(this.value)">
        </div>

        <button type="button" class="city-btn-tile" style="width: 100%; margin-bottom: 16px; background: #ecfdf5; border-color: #a7f3d0; color: #065f46; display: flex; align-items: center; justify-content: center; gap: 8px;" onclick="detectGPSLocation()">
          <i class="fa-solid fa-location-arrow"></i>
          <span>Detect My Current Location (GPS)</span>
        </button>

        <h4 style="font-size: 13px; font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Popular Service Hubs</h4>
        <div class="popular-cities-cluster" id="popularCitiesGrid">
          <button type="button" class="city-btn-tile active" onclick="selectCity('Ranchi, Jharkhand')">Ranchi</button>
          <button type="button" class="city-btn-tile" onclick="selectCity('Bengaluru, Karnataka')">Bengaluru</button>
          <button type="button" class="city-btn-tile" onclick="selectCity('Mumbai, Maharashtra')">Mumbai</button>
          <button type="button" class="city-btn-tile" onclick="selectCity('New Delhi, Delhi')">Delhi NCR</button>
          <button type="button" class="city-btn-tile" onclick="selectCity('Hyderabad, Telangana')">Hyderabad</button>
          <button type="button" class="city-btn-tile" onclick="selectCity('Kolkata, West Bengal')">Kolkata</button>
          <button type="button" class="city-btn-tile" onclick="selectCity('Pune, Maharashtra')">Pune</button>
          <button type="button" class="city-btn-tile" onclick="selectCity('Chennai, Tamil Nadu')">Chennai</button>
        </div>
      </div>
    </div>
  </div>

  <!-- AUTHENTICATION MODAL -->
  <div id="loginModal" class="overlay-modal" onclick="closeLoginModal(event)">
    <div class="modal-frame" style="max-width: 440px;">
      <div class="modal-top-bar">
        <h3>Sign In to Infinity Ventures</h3>
        <button type="button" class="btn-close-circle" onclick="closeLoginModalDirect()"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-content-area">
        <div class="model-toggle-pill" style="width: 100%; margin-bottom: 22px;">
          <button type="button" class="model-tab-btn active" id="authTabCustomer" style="flex: 1; justify-content: center;" onclick="switchAuthRole('user')">Customer</button>
          <button type="button" class="model-tab-btn" id="authTabVendor" style="flex: 1; justify-content: center;" onclick="switchAuthRole('vendor')">Service Partner</button>
        </div>

        <form method="POST" action="{% url 'login' %}">
          {% csrf_token %}
          <div class="bidding-input-group">
            <label style="color: var(--text-dark);">Phone Number or Email</label>
            <input type="text" name="username" class="input-dark-custom" style="color: #090d16; background: #f8fafc; border: 1px solid var(--border-subtle);" placeholder="e.g. 9812345678 or ananya@example.com" value="ananya" required>
          </div>

          <div class="bidding-input-group">
            <label style="color: var(--text-dark);">Password</label>
            <input type="password" name="password" class="input-dark-custom" style="color: #090d16; background: #f8fafc; border: 1px solid var(--border-subtle);" placeholder="Enter password" value="pass123" required>
          </div>

          <button type="submit" class="btn-broadcast-job" style="background: var(--primary); width: 100%;">
            <span>Sign In</span>
            <i class="fa-solid fa-arrow-right"></i>
          </button>
        </form>

        <div style="margin-top: 22px; text-align: center; font-size: 13.5px; color: var(--text-muted);">
          <span>Don't have an account?</span>
          <a href="{% url 'register_user' %}" style="color: var(--indigo-core); font-weight: 700; margin-left: 4px;">Create Account</a>
          <div style="margin-top: 8px;">
            <a href="{% url 'register_vendor' %}" style="color: var(--text-dark); font-weight: 700;">Partner Onboarding &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- REAL-TIME SOCIAL PROOF TOAST -->
  <div id="liveSocialToast" class="live-social-toast">
    <div class="toast-icon-pulse">
      <i id="toastIcon" class="fa-solid fa-snowflake"></i>
    </div>
    <div class="toast-copy">
      <h6 id="toastProTitle">Foam Jet Split AC Service</h6>
      <p id="toastMetaDesc">Indranil M. · Indiranagar, Ranchi · 2 mins ago</p>
    </div>
  </div>

  <!-- JAVASCRIPT & GSAP CONTROLLER -->
  <script>
    // Master Services Catalog Definition
    const servicesCatalog = {
      's1': {
        id: 's1',
        title: 'Foam Jet Split AC Service',
        category: 'AC',
        price: 499,
        originalPrice: 699,
        duration: '45 mins',
        rating: 4.84,
        img: 'https://images.unsplash.com/photo-1621905251189-08b45d6a269e?auto=format&fit=crop&w=700&q=80',
        inclusions: [
          'High-pressure water jet wash of cooling coils',
          'Anti-bacterial foam application for deep dust removal',
          'Outdoor unit wash & fan blade cleaning',
          'Gas leak check & drain pipe clearance'
        ],
        exclusions: [
          'Gas charging (billed separately if needed)',
          'Spare parts replacement'
        ]
      },
      's2': {
        id: 's2',
        title: 'Intense Bathroom Deep Cleaning',
        category: 'Cleaning',
        price: 399,
        originalPrice: 549,
        duration: '60 mins',
        rating: 4.88,
        img: 'https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=700&q=80',
        inclusions: [
          'Single disc machine scrubbing for stubborn tile grime',
          'Hard water descaling of taps, shower & mirror',
          'Anti-fungal spray treatment for corners'
        ],
        exclusions: [
          'Tile regrouting or crack repair'
        ]
      },
      's3': {
        id: 's3',
        title: 'Switchboard & Wiring Repair',
        category: 'Repair',
        price: 149,
        originalPrice: 249,
        duration: '30 mins',
        rating: 4.82,
        img: 'https://images.unsplash.com/photo-1621905252507-b35492cc74b4?auto=format&fit=crop&w=700&q=80',
        inclusions: [
          'Earthing & voltage load testing',
          'Switchboard replacement / repair with safety insulation',
          '30-day rework warranty'
        ],
        exclusions: [
          'Cost of new switches or wiring spool'
        ]
      },
      's4': {
        id: 's4',
        title: 'Tap & Mixer Repair / Fitting',
        category: 'Repair',
        price: 199,
        originalPrice: 299,
        duration: '30 mins',
        rating: 4.79,
        img: 'https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=700&q=80',
        inclusions: [
          'Fixing leakages & low water flow',
          'Teflon seal re-application',
          'Wall mixer & sink tap servicing'
        ],
        exclusions: [
          'Cost of new brass tap/mixer if replaced'
        ]
      },
      's5': {
        id: 's5',
        title: 'Full Kitchen Degreasing & Scrub',
        category: 'Cleaning',
        price: 799,
        originalPrice: 1099,
        duration: '90 mins',
        rating: 4.86,
        img: 'https://images.unsplash.com/photo-1527515637462-cff94eecc1ac?auto=format&fit=crop&w=700&q=80',
        inclusions: [
          'Chimney filter degreasing with heavy alkali solution',
          'Gas stove & burner unclogging',
          'Kitchen tile backsplash stain clearance'
        ],
        exclusions: [
          'Inside cleaning of refrigerator/oven (available as add-on)'
        ]
      },
      's6': {
        id: 's6',
        title: 'Full Home Painting Consultation',
        category: 'Painting',
        price: 0,
        originalPrice: 0,
        duration: 'Free Visit',
        rating: 4.91,
        img: 'https://images.unsplash.com/photo-1589939705384-5185137a7f0f?auto=format&fit=crop&w=700&q=80',
        inclusions: [
          'Laser measurement of all walls & ceilings',
          'Moisture reading to detect dampness',
          'Custom contractor quotations'
        ],
        exclusions: [
          'Actual paint materials & labor (covered in quote)'
        ]
      }
    };

    // State
    let cart = {};
    let appliedCoupon = 'UCFIRST';
    let discountAmount = 100;
    let selectedDay = 'Today';
    let selectedTime = '09:00 AM - 12:00 PM';
    let activeModalServiceId = null;

    // GSAP ANIMATION ENGINE & CONTROLLERS
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof gsap !== 'undefined') {
        if (typeof ScrollTrigger !== 'undefined') {
          gsap.registerPlugin(ScrollTrigger);
        }

        // 1. Hero Elements Staggered Entrance
        gsap.from('.gsap-fade', {
          y: 35,
          opacity: 0,
          stagger: 0.1,
          duration: 0.9,
          ease: 'power3.out'
        });

        gsap.from('.gsap-card', {
          scale: 0.92,
          opacity: 0,
          duration: 1.1,
          delay: 0.25,
          ease: 'power3.out'
        });

        // 2. ScrollTrigger: Category Cards Stagger
        gsap.from('.lifestyle-cat-card', {
          scrollTrigger: {
            trigger: '.category-cards-grid',
            start: 'top 85%',
            once: true
          },
          y: 50,
          opacity: 0,
          stagger: 0.07,
          duration: 0.85,
          ease: 'power3.out'
        });

        // 3. ScrollTrigger: Promo Bento Banners
        gsap.from('.bento-promo-card', {
          scrollTrigger: {
            trigger: '.promo-cards-grid',
            start: 'top 85%',
            once: true
          },
          y: 40,
          opacity: 0,
          stagger: 0.12,
          duration: 0.85,
          ease: 'power3.out'
        });

        // 4. ScrollTrigger: Most Booked Services Cards
        gsap.from('.service-package-card', {
          scrollTrigger: {
            trigger: '#catalogCardsContainer',
            start: 'top 85%',
            once: true
          },
          y: 50,
          opacity: 0,
          stagger: 0.08,
          duration: 0.85,
          ease: 'power3.out'
        });

        // 5. Universal 3D Tilt Physics on ALL Cards (Categories, Services, Bento, Hero)
        const tiltCards = document.querySelectorAll('.lifestyle-cat-card, .service-package-card, .bento-promo-card, .hero-featured-card');
        tiltCards.forEach(card => {
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            gsap.to(card, {
              rotationY: x * 0.04,
              rotationX: -y * 0.04,
              transformPerspective: 950,
              ease: 'power1.out',
              duration: 0.25
            });
          });

          card.addEventListener('mouseleave', () => {
            gsap.to(card, {
              rotationY: 0,
              rotationX: 0,
              ease: 'power2.out',
              duration: 0.55
            });
          });
        });

        // 6. Live Metrics Animated Counter
        document.querySelectorAll('.live-counter').forEach(counter => {
          const target = +counter.getAttribute('data-target') || 50000;
          let obj = { val: 0 };
          gsap.to(obj, {
            val: target,
            duration: 2.2,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: counter,
              start: 'top 95%',
              once: true
            },
            onUpdate: () => {
              counter.textContent = Math.floor(obj.val).toLocaleString() + '+';
            }
          });
        });
      }

      // 7. Rotating Live Social Proof Notification Toast
      const socialAlerts = [
        { pro: 'Foam Jet Split AC Service', user: 'Indranil M.', loc: 'Indiranagar, Ranchi', time: '2 mins ago', icon: 'fa-snowflake' },
        { pro: "Women's Salon Glow Facial", user: 'Pooja V.', loc: 'Kanke Road, Ranchi', time: '4 mins ago', icon: 'fa-wand-magic-sparkles' },
        { pro: 'Switchboard & MCB Repair', user: 'Rahul S.', loc: 'Hinoo, Ranchi', time: 'Just now', icon: 'fa-bolt' },
        { pro: '3 BHK Painting Quotation', user: 'Amit K.', loc: 'Bariatu Road', time: '7 mins ago', icon: 'fa-paint-roller' },
        { pro: 'Bathroom Machine Scrub', user: 'Sneha T.', loc: 'Morabadi', time: '9 mins ago', icon: 'fa-spray-can-sparkles' }
      ];

      let alertIdx = 0;
      function rotateSocialProof() {
        const toast = document.getElementById('liveSocialToast');
        if (!toast) return;
        const item = socialAlerts[alertIdx % socialAlerts.length];
        alertIdx++;

        const titleEl = document.getElementById('toastProTitle');
        const metaEl = document.getElementById('toastMetaDesc');
        const iconEl = document.getElementById('toastIcon');

        if (titleEl && metaEl && iconEl) {
          titleEl.textContent = item.pro;
          metaEl.textContent = `${item.user} · ${item.loc} · ${item.time}`;
          iconEl.className = `fa-solid ${item.icon}`;
        }

        toast.classList.add('active');
        setTimeout(() => {
          toast.classList.remove('active');
        }, 4000);
      }

      setInterval(rotateSocialProof, 8500);
      setTimeout(rotateSocialProof, 2000);
    });

    // Cart Functions
    function addInstantService(id) {
      if (!cart[id]) {
        cart[id] = 1;
      } else {
        cart[id]++;
      }
      updateCartUI();
      openCartDrawer();
    }

    function changeServiceQty(id, delta) {
      if (cart[id]) {
        cart[id] += delta;
        if (cart[id] <= 0) {
          delete cart[id];
        }
      }
      updateCartUI();
    }

    function updateCartUI() {
      const ids = Object.keys(cart);
      const totalCount = ids.reduce((acc, k) => acc + cart[k], 0);

      document.getElementById('cartCountBadge').textContent = totalCount;
      document.getElementById('drawerCountPill').textContent = totalCount;
      if (typeof gsap !== 'undefined' && totalCount > 0) {
        gsap.fromTo('#cartCountBadge', { scale: 1.6 }, { scale: 1, duration: 0.35, ease: 'back.out(2.5)' });
      }

      Object.keys(servicesCatalog).forEach(id => {
        const btnAdd = document.getElementById('btnAdd_' + id);
        const stepper = document.getElementById('stepper_' + id);
        const qtySpan = document.getElementById('qty_' + id);

        if (btnAdd && stepper && qtySpan) {
          if (cart[id] && cart[id] > 0) {
            btnAdd.style.display = 'none';
            stepper.style.display = 'flex';
            qtySpan.textContent = cart[id];
          } else {
            btnAdd.style.display = 'block';
            stepper.style.display = 'none';
          }
        }
      });

      let itemTotal = 0;
      ids.forEach(id => {
        const item = servicesCatalog[id];
        if (item) itemTotal += item.price * cart[id];
      });

      const cartActiveContent = document.getElementById('cartActiveContent');
      const cartEmptyMessage = document.getElementById('cartEmptyMessage');
      const cartDrawerFooter = document.getElementById('cartDrawerFooter');
      const cartItemsList = document.getElementById('cartItemsList');

      if (totalCount === 0) {
        cartActiveContent.style.display = 'none';
        cartEmptyMessage.style.display = 'block';
        cartDrawerFooter.style.display = 'none';
        document.getElementById('cartHeaderAmount').textContent = '₹0';
      } else {
        cartActiveContent.style.display = 'block';
        cartEmptyMessage.style.display = 'none';
        cartDrawerFooter.style.display = 'block';

        let html = '';
        ids.forEach(id => {
          const item = servicesCatalog[id];
          html += `
            <div class="cart-line-item">
              <div class="cart-line-info">
                <h4>${item.title}</h4>
                <span>₹${item.price} &times; ${cart[id]} = ₹${item.price * cart[id]}</span>
              </div>
              <div class="quantity-stepper-ui" style="display: flex;">
                <button type="button" class="stepper-btn-action" onclick="changeServiceQty('${id}', -1)">-</button>
                <span class="stepper-live-val">${cart[id]}</span>
                <button type="button" class="stepper-btn-action" onclick="changeServiceQty('${id}', 1)">+</button>
              </div>
            </div>
          `;
        });
        cartItemsList.innerHTML = html;

        let actualDiscount = (appliedCoupon && itemTotal > 200) ? discountAmount : 0;
        const hygieneFee = 49;
        const taxes = Math.round(itemTotal * 0.05);
        const grandTotal = Math.max(0, itemTotal - actualDiscount + hygieneFee + taxes);

        document.getElementById('billItemTotal').textContent = '₹' + itemTotal;
        const discountRow = document.getElementById('billDiscountRow');
        if (actualDiscount > 0) {
          discountRow.style.display = 'flex';
          document.getElementById('billDiscount').textContent = '-₹' + actualDiscount;
        } else {
          discountRow.style.display = 'none';
        }

        document.getElementById('billTaxes').textContent = '₹' + taxes;
        document.getElementById('billGrandTotal').textContent = '₹' + grandTotal;
        document.getElementById('cartHeaderAmount').textContent = '₹' + grandTotal;
        document.getElementById('footerBtnAmount').textContent = 'Pay ₹' + grandTotal;
      }
    }

    function toggleCartDrawer() {
      const drawer = document.getElementById('cartDrawer');
      const overlay = document.getElementById('cartDrawerOverlay');
      drawer.classList.toggle('active');
      overlay.classList.toggle('active');
    }

    function openCartDrawer() {
      document.getElementById('cartDrawer').classList.add('active');
      document.getElementById('cartDrawerOverlay').classList.add('active');
    }

    function applyCouponCode() {
      const code = document.getElementById('couponInput').value.trim().toUpperCase();
      const msg = document.getElementById('couponMessage');
      if (code === 'UCFIRST' || code === 'SUMMER50') {
        appliedCoupon = code;
        discountAmount = code === 'UCFIRST' ? 100 : 50;
        msg.style.display = 'block';
        msg.textContent = `Coupon ${code} applied! ₹${discountAmount} discount added.`;
        updateCartUI();
      } else {
        alert('Invalid coupon code. Try UCFIRST or SUMMER50');
      }
    }

    function selectSlotDay(btn, day) {
      document.querySelectorAll('.city-btn-tile').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selectedDay = day;
    }

    function selectSlotTime(btn, time) {
      document.querySelectorAll('.city-btn-tile').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      selectedTime = time;
    }

    function executeInstantBooking() {
      document.getElementById('drawerStepCart').style.display = 'none';
      document.getElementById('cartDrawerFooter').style.display = 'none';
      document.getElementById('drawerStepTracking').style.display = 'block';
      document.getElementById('confirmedRefId').textContent = '#IV-' + Math.floor(10000 + Math.random() * 90000);
    }

    function resetCartAndClose() {
      cart = {};
      updateCartUI();
      document.getElementById('drawerStepTracking').style.display = 'none';
      document.getElementById('drawerStepCart').style.display = 'block';
      toggleCartDrawer();
    }

    // Bidding
    function handlePostCustomRequirement(e) {
      e.preventDefault();
      const title = document.getElementById('bidTitle').value;
      const budget = document.getElementById('bidBudget').value;
      const btn = document.getElementById('btnSubmitBid');
      
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Broadcasting to 14 verified contractors...';

      setTimeout(() => {
        btn.disabled = false;
        btn.innerHTML = '<span>Broadcast to Local Contractors</span> <i class="fa-solid fa-paper-plane"></i>';
        alert(`Your requirement "${title}" (Est. ₹${budget}) has been posted successfully!\n\n14 verified contractors in your area have been notified. You will start receiving quotations with price and work proposals shortly!`);
        document.getElementById('biddingPostForm').reset();
      }, 1200);
    }

    function handleAcceptBidDemo(vendorName, amount) {
      alert(`🎉 You have selected ${vendorName} for ₹${amount.toLocaleString()}!\n\nA dedicated project coordinator will reach out to schedule site inspection and verify work milestones.`);
    }

    // Service Detail Modal
    function openServiceDetailModal(id) {
      const item = servicesCatalog[id];
      if (!item) return;
      activeModalServiceId = id;
      document.getElementById('modalServiceTitle').textContent = item.title;
      document.getElementById('modalServiceImg').src = item.img;
      document.getElementById('modalServiceRating').innerHTML = `<i class="fa-solid fa-star"></i> ${item.rating}`;
      document.getElementById('modalServiceDuration').textContent = item.duration;
      document.getElementById('modalServicePrice').textContent = '₹' + item.price;

      const incList = document.getElementById('modalServiceInclusions');
      incList.innerHTML = item.inclusions.map(i => `<li><i class="fa-solid fa-circle-check"></i> ${i}</li>`).join('');

      const excList = document.getElementById('modalServiceExclusions');
      excList.innerHTML = item.exclusions.map(e => `<li><i class="fa-solid fa-circle-xmark" style="color: #94a3b8;"></i> ${e}</li>`).join('');

      document.getElementById('serviceDetailModal').classList.add('active');
    }

    function addFromModal() {
      if (activeModalServiceId) {
        addInstantService(activeModalServiceId);
        closeServiceDetailModalDirect();
      }
    }

    function closeServiceDetailModal(e) {
      if (e.target === document.getElementById('serviceDetailModal')) closeServiceDetailModalDirect();
    }

    function closeServiceDetailModalDirect() {
      document.getElementById('serviceDetailModal').classList.remove('active');
    }

    // Location Modal
    function openLocationModal() {
      document.getElementById('locationModal').classList.add('active');
    }

    function closeLocationModal(e) {
      if (e.target === document.getElementById('locationModal')) closeLocationModalDirect();
    }

    function closeLocationModalDirect() {
      document.getElementById('locationModal').classList.remove('active');
    }

    function selectCity(cityName) {
      document.getElementById('currentCityText').textContent = cityName;
      closeLocationModalDirect();
    }

    function detectGPSLocation() {
      const btn = event.currentTarget;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Detecting GPS...';
      setTimeout(() => {
        selectCity('Ranchi, Jharkhand');
        btn.innerHTML = '<i class="fa-solid fa-location-arrow"></i> <span>Detect My Current Location (GPS)</span>';
      }, 600);
    }

    function filterCityButtons(query) {
      const btns = document.querySelectorAll('#popularCitiesGrid .city-btn-tile');
      btns.forEach(b => {
        const text = b.textContent.toLowerCase();
        b.style.display = text.includes(query.toLowerCase()) ? 'block' : 'none';
      });
    }

    // Auth Modal
    function openLoginModal() {
      document.getElementById('loginModal').classList.add('active');
    }

    function closeLoginModal(e) {
      if (e.target === document.getElementById('loginModal')) closeLoginModalDirect();
    }

    function closeLoginModalDirect() {
      document.getElementById('loginModal').classList.remove('active');
    }

    function switchAuthRole(role) {
      document.getElementById('authTabCustomer').classList.toggle('active', role === 'user');
      document.getElementById('authTabVendor').classList.toggle('active', role === 'vendor');
    }

    // Search
    function handleSearch(val) {
      const dropdown = document.getElementById('searchDropdownMenu');
      if (!val || val.trim().length < 2) {
        dropdown.classList.remove('active');
        return;
      }
      const q = val.toLowerCase().trim();
      const matches = Object.values(servicesCatalog).filter(s => 
        s.title.toLowerCase().includes(q) || s.category.toLowerCase().includes(q)
      );

      if (matches.length > 0) {
        dropdown.innerHTML = matches.map(m => `
          <div class="search-row-item" onclick="addInstantService('${m.id}')">
            <div class="s-thumb-left">
              <img class="s-thumb-img" src="${m.img}" alt="">
              <div>
                <div class="s-title">${m.title}</div>
                <div class="s-meta">★ ${m.rating} · ${m.duration}</div>
              </div>
            </div>
            <div style="font-weight: 800; color: var(--text-dark);">₹${m.price}</div>
          </div>
        `).join('');
        dropdown.classList.add('active');
      } else {
        dropdown.innerHTML = '<div style="padding: 14px 18px; font-size: 13px; color: var(--text-muted);">No exact match found. Try "AC", "Cleaning", or "Repair".</div>';
        dropdown.classList.add('active');
      }
    }

    function executeHeroSearch() {
      const q = document.getElementById('heroSearchInput').value.trim();
      if (q) filterServicesByCategory(q);
    }

    document.addEventListener('click', (e) => {
      if (!e.target.closest('.nav-search-box')) {
        document.getElementById('searchDropdownMenu').classList.remove('active');
      }
      if (!e.target.closest('.user-profile-widget') && document.getElementById('userDropdown')) {
        document.getElementById('userDropdown').classList.remove('active');
      }
      if (!e.target.closest('.portal-dropdown-container') && document.getElementById('portalDropdown')) {
        document.getElementById('portalDropdown').classList.remove('active');
      }
    });

    function toggleUserDropdown() {
      document.getElementById('userDropdown').classList.toggle('active');
    }

    function togglePortalDropdown() {
      document.getElementById('portalDropdown').classList.toggle('active');
    }

    function scrollToBidding() {
      const el = document.getElementById('biddingShowcaseSection');
      if (el) el.scrollIntoView({ behavior: 'smooth' });
    }

    function switchMainModel(model) {
      document.getElementById('tabInstant').classList.toggle('active', model === 'instant');
      document.getElementById('tabBidding').classList.toggle('active', model === 'bidding');

      if (model === 'bidding') {
        scrollToBidding();
      } else {
        const el = document.getElementById('servicesCatalogSection');
        if (el) el.scrollIntoView({ behavior: 'smooth' });
      }
    }

    function filterServicesByCategory(cat) {
      const cards = document.querySelectorAll('#catalogCardsContainer .service-package-card');
      const title = document.getElementById('catalogTitleDisplay');
      title.textContent = (cat === 'All' || !cat) ? 'Most Booked Services' : cat + ' Services';

      cards.forEach(card => {
        const c = card.getAttribute('data-category');
        if (cat === 'All' || !cat || c.toLowerCase().includes(cat.toLowerCase())) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });

      const sec = document.getElementById('servicesCatalogSection');
      if (sec) sec.scrollIntoView({ behavior: 'smooth' });
    }

    function setCatalogFilter(btn, cat) {
      document.querySelectorAll('.filter-tab-pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filterServicesByCategory(cat);
    }
  </script>
</body>
</html>