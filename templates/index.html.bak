  <!-- MOST BOOKED SERVICES CATALOG -->
  <section class="services-catalog-section" id="servicesCatalogSection">
    <div class="container">
      <div class="section-headline-row">
        <div class="section-title-wrap">
          <h2 id="catalogTitleDisplay">Most Booked Services</h2>
          <p>Standardized pricing, genuine spare parts, and 30-day service warranty</p>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="catalog-filter-tabs">
        <button type="button" class="filter-tab-pill active" onclick="setCatalogFilter(this, 'All')">All Services</button>
        <button type="button" class="filter-tab-pill" onclick="setCatalogFilter(this, 'AC')">AC &amp; Appliances</button>
        <button type="button" class="filter-tab-pill" onclick="setCatalogFilter(this, 'Cleaning')">Cleaning &amp; Pest</button>
        <button type="button" class="filter-tab-pill" onclick="setCatalogFilter(this, 'Repair')">Electrician &amp; Plumber</button>
        <button type="button" class="filter-tab-pill" onclick="setCatalogFilter(this, 'Painting')">Painting Consultation</button>
      </div>

      <!-- Services Grid -->
      <div class="services-catalog-grid" id="catalogCardsContainer">
        <!-- Service Card 1: AC -->
        <div class="service-package-card" data-category="AC">
          <div class="package-photo-top">
            <img src="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?auto=format&fit=crop&w=700&q=80" alt="AC Service">
            <div class="photo-overlay-scrim"></div>
            <div class="duration-pill-tag"><i class="fa-solid fa-clock"></i> 45 mins</div>
            <div class="warranty-corner-tag"><i class="fa-solid fa-shield-halved"></i> 30-Day Warranty</div>
            <div class="live-pros-strip">
              <span class="pulse-dot-green"></span>
              <span>42 Verified Pros Near You</span>
            </div>
          </div>
          <div class="package-details-body">
            <div class="rating-meta-row">
              <div class="rating-left-wrap">
                <span class="star-score-badge"><i class="fa-solid fa-star"></i> 4.84</span>
                <span class="ratings-volume">(142K+ reviews)</span>
              </div>
              <span class="verified-pro-stamp"><i class="fa-solid fa-certificate"></i> Verified Pro</span>
            </div>
            <h3 class="service-package-title">Foam Jet Split AC Deep Service</h3>
            <ul class="package-checklist">
              <li><i class="fa-solid fa-circle-check"></i> <span><strong>2X Deeper Cooling</strong> with high-pressure water jet pump</span></li>
              <li><i class="fa-solid fa-circle-check"></i> <span>Indoor &amp; outdoor unit anti-bacterial foam treatment</span></li>
              <li><i class="fa-solid fa-circle-check"></i> <span>Gas leak diagnosis &amp; complete electrical safety audit</span></li>
            </ul>
            <div class="pro-avatars-row">
              <div class="avatars-stacked">
                <img class="avatar-micro" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&q=80" alt="Pro">
                <img class="avatar-micro" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=100&q=80" alt="Pro">
                <img class="avatar-micro" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=100&q=80" alt="Pro">
              </div>
              <span class="avatars-caption">Manoj, Rajesh &amp; 40+ certified technicians</span>
            </div>
            <div class="package-card-footer">
              <div class="price-meta-block">
                <div class="price-numbers-row">
                  <span class="final-price-num">₹499</span>
                  <span class="strikethrough-price-num">₹699</span>
                </div>
                <span class="savings-badge-pill">SAVE ₹200 (28% OFF)</span>
              </div>
              <div class="action-controls-row">
                <button type="button" class="btn-read-details" onclick="openServiceDetailModal('s1')">Details</button>
                <button type="button" id="btnAdd_s1" class="btn-add-to-cart" onclick="addInstantService('s1')">+ Add</button>
                <div id="stepper_s1" class="quantity-stepper-ui">
                  <button type="button" class="stepper-btn-action" onclick="changeServiceQty('s1', -1)">-</button>
                  <span id="qty_s1" class="stepper-live-val">1</span>
                  <button type="button" class="stepper-btn-action" onclick="changeServiceQty('s1', 1)">+</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Service Card 2: Cleaning -->
        <div class="service-package-card" data-category="Cleaning">
          <div class="package-photo-top">
            <img src="https://images.unsplash.com/photo-1581578731548-c64695cc6952?auto=format&fit=crop&w=700&q=80" alt="Bathroom Deep Cleaning">
