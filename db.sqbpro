lue="300"/><column index="18" value="55"/><column index="19" value="130"/><column index="20" value="135"/><column index="21" value="300"/><column index="22" value="300"/><column index="23" value="183"/><column index="24" value="151"/><column index="25" value="124"/><column index="26" value="108"/><column index="27" value="63"/><column index="28" value="104"/><column index="29" value="87"/><column index="30" value="167"/><column index="31" value="87"/><column index="32" value="55"/><column index="33" value="79"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="myapp_userprofile" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="127"/><column index="3" value="52"/><column index="4" value="300"/><column index="5" value="79"/><column index="6" value="79"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter><filter value="98765432"/></global_filter></table><table schema="main" name="myapp_vendorprofile" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="300"/><column index="3" value="231"/><column index="4" value="175"/><column index="5" value="42"/><column index="6" value="215"/><column index="7" value="52"/><column index="8" value="300"/><column index="9" value="87"/><column index="10" value="71"/><column index="11" value="48"/><column index="12" value="223"/><column index="13" value="300"/><column index="14" value="300"/><column index="15" value="98"/><column index="16" value="300"/><column index="17" value="81"/><column index="18" value="87"/><column index="19" value="82"/><column index="20" value="89"/><column index="21" value="58"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT 
    -- Booking details
    &quot;myapp_servicebooking&quot;.&quot;id&quot;, 
    &quot;myapp_servicebooking&quot;.&quot;customer_id&quot;, 
    &quot;myapp_servicebooking&quot;.&quot;vendor_id&quot;, 
    &quot;myapp_servicebooking&quot;.&quot;quick_service_id&quot;, 
    &quot;myapp_servicebooking&quot;.&quot;package_name&quot;, 
    &quot;myapp_servicebooking&quot;.&quot;total_amount&quot;, 
    &quot;myapp_servicebooking&quot;.&quot;scheduled_date&quot;, 
    &quot;myapp_servicebooking&quot;.&quot;scheduled_time&quot;, 
    &quot;myapp_servicebooking&quot;.&quot;service_address&quot;, 
    &quot;myapp_servicebooking&quot;.&quot;status&quot;, 
    &quot;myapp_servicebooking&quot;.&quot;payment_status&quot;, 
    &quot;myapp_servicebooking&quot;.&quot;created_at&quot;,
    
    -- Vendor Details (from myapp_customuser alias T3)
    &quot;T3&quot;.&quot;id&quot;, 
    &quot;T3&quot;.&quot;first_name&quot;, 
    &quot;T3&quot;.&quot;last_name&quot;, 
    &quot;T3&quot;.&quot;username&quot;, 
    
    -- Quick Service details
    &quot;myapp_quickservice&quot;.&quot;id&quot;, 
    &quot;myapp_quickservice&quot;.&quot;title&quot;, 
    &quot;myapp_quickservice&quot;.&quot;base_price&quot;,
    
    -- Review Details
    &quot;myapp_servicereview&quot;.&quot;id&quot;, 
    &quot;myapp_servicereview&quot;.&quot;rating&quot;, 
    &quot;myapp_servicereview&quot;.&quot;comment&quot;
    
FROM &quot;myapp_servicebooking&quot; 

-- Join to fetch vendor information
INNER JOIN &quot;myapp_customuser&quot; &quot;T3&quot; 
    ON (&quot;myapp_servicebooking&quot;.&quot;vendor_id&quot; = &quot;T3&quot;.&quot;id&quot;) 

-- Join to fetch the quick service details
LEFT OUTER JOIN &quot;myapp_quickservice&quot; 
    ON (&quot;myapp_servicebooking&quot;.&quot;quick_service_id&quot; = &quot;myapp_quickservice&quot;.&quot;id&quot;) 

-- Join to fetch the review left on this booking (if any)
LEFT OUTER JOIN &quot;myapp_servicereview&quot; 
    ON (&quot;myapp_servicebooking&quot;.&quot;id&quot; = &quot;myapp_servicereview&quot;.&quot;booking_id&quot;) 

-- Filter by the specific customer
WHERE &quot;myapp_servicebooking&quot;.&quot;customer_id&quot; = 104 

ORDER BY &quot;myapp_servicebooking&quot;.&quot;created_at&quot; DESC;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
